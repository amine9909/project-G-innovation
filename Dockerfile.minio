FROM golang:1.24-alpine AS build

RUN apk add --no-cache git ca-certificates

RUN GOBIN=/build go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z


FROM alpine:3.22

RUN apk add --no-cache ca-certificates

COPY --from=build /build/minio /usr/local/bin/minio

EXPOSE 9000 9001

VOLUME ["/data"]

ENTRYPOINT ["minio"]
